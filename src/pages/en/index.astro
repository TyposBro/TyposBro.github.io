---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/utils';
import { HIDDEN_PROJECT_SLUGS } from '../../config';

const locale = 'en' as const;

const all = await getCollection('projects', ({ data }) =>
  data.locale === locale && !data.hidden && !HIDDEN_PROJECT_SLUGS.includes(data.key as any)
);
const projects = all.sort((a, b) => a.data.order - b.data.order);
---

<Base locale={locale}>
  <section class="mb-16">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight leading-tight max-w-3xl">
      {t(locale, 'hero.title')}
    </h1>
    <p class="text-[var(--color-muted)] mt-4 max-w-2xl">
      {t(locale, 'hero.subtitle')}
    </p>
    <div class="flex gap-4 mt-6">
      <a
        href={`/${locale}/projects/`}
        class="inline-block border border-[var(--color-accent)] text-[var(--color-accent)] px-4 py-2 rounded-md hover:bg-[var(--color-accent)] hover:text-[var(--color-bg)] transition-colors"
      >
        {t(locale, 'hero.cta_projects')}
      </a>
      <a
        href={`/${locale}/contact/`}
        class="inline-block border border-[var(--color-border)] px-4 py-2 rounded-md hover:border-[var(--color-fg)] transition-colors"
      >
        {t(locale, 'hero.cta_contact')}
      </a>
    </div>
  </section>

    <section class="mb-16">
    <h2 class="text-xl font-semibold mb-6">{t(locale, 'services.label')}</h2>
    <ul class="space-y-3 max-w-3xl">
      <li class="flex gap-3"><span class="text-[var(--color-accent)]">&rarr;</span><span>{t(locale, 'services.ship')}</span></li>
      <li class="flex gap-3"><span class="text-[var(--color-accent)]">&rarr;</span><span>{t(locale, 'services.rescue')}</span></li>
      <li class="flex gap-3"><span class="text-[var(--color-accent)]">&rarr;</span><span>{t(locale, 'services.backend')}</span></li>
      <li class="flex gap-3"><span class="text-[var(--color-accent)]">&rarr;</span><span>{t(locale, 'services.ai')}</span></li>
    </ul>
    <p class="text-sm text-[var(--color-muted)] mt-6 max-w-3xl">{t(locale, 'availability.text')}</p>
  </section>

<section class="mb-16">
    <h2 class="text-xl font-semibold mb-6">{t(locale, 'projects.featured')}</h2>
    <div class="grid sm:grid-cols-2 gap-6">
      {projects.map((p) => <ProjectCard project={p} locale={locale} />)}
    </div>
  </section>
</Base>
