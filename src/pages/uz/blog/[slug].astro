---
import Base from '../../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  // English content stands in where no Uzbek translation exists — see the note
  // in src/pages/ru/blog/[slug].astro.
  const all = await getCollection('posts', ({ data }) =>
    (data.locale === 'uz' || data.locale === 'en') && !data.draft
  );
  const byKey = new Map<string, (typeof all)[number]>();
  for (const post of all) {
    const existing = byKey.get(post.data.key);
    if (!existing || (existing.data.locale === 'en' && post.data.locale === 'uz')) {
      byKey.set(post.data.key, post);
    }
  }
  return Array.from(byKey.values()).map((post) => ({
    params: { slug: post.data.key },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Base locale="uz" title={`${post.data.title} — Azizbek Umidjonov`} description={post.data.excerpt}>
  <article class="max-w-2xl mx-auto">
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight mb-2">{post.data.title}</h1>
      <time class="text-sm font-mono text-[var(--color-muted)]" datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
    </header>
    <div class="prose prose-invert max-w-none prose-headings:font-semibold prose-p:text-[var(--color-fg)] prose-a:text-[var(--color-accent)]">
      <Content />
    </div>
  </article>
</Base>
